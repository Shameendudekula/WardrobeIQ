# ---------- Required ----------
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wardrobeiq?retryWrites=true&w=majority
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=

# ---------- AI stylist ----------
# anthropic (default) | openai (any OpenAI-compatible endpoint) | mock (development/tests only — output is labelled as not AI-generated)
AI_PROVIDER=anthropic
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override. Anthropic default: claude-opus-5-5 (cheaper options: claude-sonnet-5-5, claude-haiku-5-5).
# Required when AI_PROVIDER=openai.
AI_MODEL=
# OpenAI-compatible provider only (also used for free-tier providers — see README "Free AI providers")
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_JSON_MODE=json_object    # only if the model rejects strict JSON-schema output
# Optional tuning
# AI_EFFORT=medium            # Anthropic effort: low | medium | high (unset = model default)
# AI_TIMEOUT_MS=60000         # per-request timeout
# AI_MAX_RETRIES=2            # SDK retries for 429/5xx/network errors
# AI_REFUSAL_FALLBACK=true    # Anthropic server-side refusal fallback on supported models
# AI_RATE_LIMIT_PER_HOUR=30   # AI requests per user per hour

# ---------- Weather ----------
# https://home.openweathermap.org/api_keys (current weather + 5-day forecast)
OPENWEATHER_API_KEY=

# ---------- Optional ----------
PORT=5001
# AUTH_RATE_LIMIT_PER_15MIN=30
# Only needed if the frontend is hosted on a different domain (comma-separated)
# CORS_ORIGIN=https://example.com
